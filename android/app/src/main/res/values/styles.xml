<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="OffsetTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#B7F34D</item>
        <item name="android:colorControlActivated">#B7F34D</item>
        <item name="android:statusBarColor">#111416</item>
        <item name="android:navigationBarColor">#111416</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:alertDialogTheme">@style/OffsetDialogTheme</item>
    </style>
    <style name="OffsetDialogTheme" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorBackground">#232B2E</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/OffsetDialogButton</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/OffsetDialogButton</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/OffsetDialogButton</item>
        <item name="android:windowBackground">@drawable/offset_dialog_background</item>
        <item name="android:colorAccent">#B7F34D</item>
        <item name="android:textColorPrimary">#F4F7F6</item>
        <item name="android:textColorSecondary">#B1BFC0</item>
        <item name="android:windowMinWidthMajor">75%</item>
        <item name="android:windowMinWidthMinor">88%</item>
        <item name="android:backgroundDimAmount">0.65</item>
    </style>
    <style name="OffsetDialogButton" parent="android:style/Widget.Material.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">12sp</item>
        <item name="android:background">@drawable/offset_button_background</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">#F4F7F6</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:minHeight">44dp</item>
    </style>
    <style name="OffsetPopupTheme" parent="OffsetDialogTheme">
        <item name="android:popupMenuStyle">@style/OffsetPopupMenu</item>
    </style>
    <style name="OffsetPopupMenu" parent="android:style/Widget.Material.PopupMenu">
        <item name="android:popupBackground">@drawable/offset_dialog_background</item>
    </style>
</resources>
